{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(uv run pytest *)"
    ],
    "ask": [
      "Bash(uv run maid-agent *)",
      "Bash(uv add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)"
    ]
  }
}
